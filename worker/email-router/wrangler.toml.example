name = "pai-email-router"
main = "src/index.ts"
compatibility_date = "2024-12-01"
compatibility_flags = ["nodejs_compat"]

# Environment variables (non-secret)
[vars]
ENVIRONMENT = "production"
JWT_ISSUER = "pai-email-agent"
JWT_AUDIENCE = "pai-agents"
DOMAIN = "axiomid.app"
AGENT_SUBDOMAIN = "agents"
WEBHOOK_BATCH_SIZE = "10"
WEBHOOK_BATCH_INTERVAL_MS = "5000"

# KV Namespaces - REPLACE WITH YOUR IDs
[[kv_namespaces]]
binding = "EMAIL_KV"
id = "<YOUR_EMAIL_KV_ID>"
preview_id = "<YOUR_EMAIL_KV_PREVIEW_ID>"

[[kv_namespaces]]
binding = "AGENT_KV"
id = "<YOUR_AGENT_KV_ID>"
preview_id = "<YOUR_AGENT_KV_PREVIEW_ID>"

[[kv_namespaces]]
binding = "RATE_LIMIT_KV"
id = "<YOUR_RATE_LIMIT_KV_ID>"
preview_id = "<YOUR_RATE_LIMIT_KV_PREVIEW_ID>"

[[kv_namespaces]]
binding = "WEBHOOK_KV"
id = "<YOUR_WEBHOOK_KV_ID>"
preview_id = "<YOUR_WEBHOOK_KV_PREVIEW_ID>"

# Durable Object
[[durable_objects.bindings]]
name = "AGENT_INBOX_DO"
class_name = "AgentInboxDO"

# Build
[build]
command = "npm run build"